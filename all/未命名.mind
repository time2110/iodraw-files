{"root":{"data":{"id":"dg4cubvhw5c0","created":1770023154910,"text":"历史"},"children":[{"data":{"id":"dg4cus1vobk0","created":1770023190124,"text":"旧石器时期"},"children":[{"data":{"id":"dg4cuws9mjk0","created":1770023200427,"text":"170万年云南 元谋人 使用火"},"children":[]},{"data":{"id":"dg4cvjpqbko0","created":1770023250339,"text":"70万-20万年 北京周口店龙骨山 北京人 使用天然火，保存火种"},"children":[]},{"data":{"id":"dg4cw6bwr080","created":1770023299570,"text":"3万年 北京周口店龙骨山 山顶洞人 人工取火，爱美观念，骨针缝制衣服"},"children":[]}]},{"data":{"id":"dg4cx3khbfs0","created":1770023371922,"text":"新石器时期","layout_mind_offset":{"x":712,"y":171}},"children":[{"data":{"id":"dg4cxenwnso0","created":1770023396073,"text":"河姆渡人，长江，种植粟和黍，种植工具骨耜"},"children":[]},{"data":{"id":"dg4d941m8ww0","created":1770024313328,"text":"红山人，内蒙古和东北，彩陶和玉雕，玉猪龙"},"children":[]}]}]},"template":"default","theme":"fresh-blue","version":"1.4.43"}